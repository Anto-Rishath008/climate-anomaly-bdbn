# Weather API Keys (Get free keys from the links below)

# WeatherAPI.com - 1 million calls/month FREE
# Sign up at: https://www.weatherapi.com/
REACT_APP_WEATHER_API_KEY=your_weather_api_key_here

# OpenWeatherMap - 1,000 calls/day FREE (backup)
# Sign up at: https://openweathermap.org/api
REACT_APP_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional: Custom API configuration
REACT_APP_API_BASE_URL=http://localhost:8000
REACT_APP_ML_MODEL_ENDPOINT=/api/predict

# Optional: Feature flags
REACT_APP_ENABLE_EXPORT=true
REACT_APP_ENABLE_REALTIME=true
REACT_APP_DEBUG_MODE=false

# Optional: Map configuration
REACT_APP_DEFAULT_MAP_CENTER_LAT=20
REACT_APP_DEFAULT_MAP_CENTER_LON=0
REACT_APP_DEFAULT_MAP_ZOOM=2